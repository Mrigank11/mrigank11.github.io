---
// Header banner: a THINK → BUILD → SHIP loop, played by the official
// <hyperframes-player> web component. The composition, the player bundle, GSAP
// and the fonts are all self-hosted under
// public/posts/development-at-the-speed-of-thought/, so the page makes no
// third-party requests for it. The poster still paints first and is all that
// reduced-motion users get (the composition is never loaded for them).
const base = "/posts/development-at-the-speed-of-thought";
const description =
  "Animated banner: THINK, a foundation of requirements, architecture, tests and orchestration; BUILD, three parallel worktrees; SHIP, everything merged into main.";
---

<figure
  class="not-prose border-border my-8 overflow-hidden rounded-lg border bg-[#0d0e12]"
  data-header-animation
>
  <div class="relative aspect-[8/3] w-full">
    <img
      src={`${base}/header-animation-poster.png`}
      alt={description}
      width="1600"
      height="600"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full"
    />
    <hyperframes-player
      data-src={`${base}/header-animation/index.html`}
      width="1600"
      height="600"
      loop
      aria-label={description}
      class="pointer-events-none absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-500 data-[ready]:opacity-100"
    ></hyperframes-player>
  </div>
</figure>

<script is:inline src={`${base}/hyperframes-player-0.8.56.global.js`}></script>

<script>
  interface Player extends HTMLElement {
    ready: boolean;
    play(): void;
    pause(): void;
  }

  function init() {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    document
      .querySelectorAll<HTMLElement>("[data-header-animation]")
      .forEach(figure => {
        const player = figure.querySelector<Player>("hyperframes-player");
        const src = player?.dataset.src;
        if (!player || !src) return;

        let visible = false;

        // Play only while on screen and motion is allowed.
        const update = () => {
          if (!player.ready) return;
          if (visible && !reduced.matches) player.play();
          else player.pause();
        };

        player.addEventListener("ready", () => {
          player.setAttribute("data-ready", "");
          update();
        });

        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          update();
        }).observe(figure);

        // Reduced motion: never load the composition, so the poster is the
        // whole story. Also follows the OS setting changing mid-page.
        const sync = () => {
          if (!figure.isConnected) {
            return reduced.removeEventListener("change", sync);
          }
          if (reduced.matches) {
            player.removeAttribute("data-ready");
            if (player.ready) player.pause();
          } else if (!player.hasAttribute("src")) {
            player.setAttribute("src", src);
          } else if (player.ready) {
            player.setAttribute("data-ready", "");
            update();
          }
        };
        reduced.addEventListener("change", sync);
        sync();
      });
  }

  document.addEventListener("astro:page-load", init);
</script>
