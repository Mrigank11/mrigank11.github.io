---
// Shared frame for the post's figures, in the Swiss language of the header
// animation: faint 40px column grid, corner register marks, one accent, mono
// labels, hard rectangles. Static on purpose — the header owns the motion.
//
// Default slot: SVG contents, drawn on a 320 x `height` canvas.
// Slot "caption": the visible takeaway. `label` is the full text alternative.
interface Props {
  label: string;
  height?: number;
}

const { label, height = 200 } = Astro.props;

const cols = [40, 80, 120, 160, 200, 240, 280];
const rows = [Math.round(height * 0.3), Math.round(height * 0.7)];
const bottom = height - 14;
---

<figure
  class="swiss-fig not-prose border-border bg-background mx-auto my-8 max-w-[30rem] border"
>
  <svg
    viewBox={`0 0 320 ${height}`}
    role="img"
    aria-label={label}
    class="block h-auto w-full"
  >
    <g class="grid">
      {cols.map(x => <line x1={x} y1="10" x2={x} y2={height - 10} />)}
      {rows.map(y => <line x1="10" y1={y} x2="310" y2={y} />)}
    </g>
    <g class="reg">
      <line x1="8" y1="14" x2="18" y2="14"></line>
      <line x1="13" y1="9" x2="13" y2="19"></line>
      <line x1="302" y1="14" x2="312" y2="14"></line>
      <line x1="307" y1="9" x2="307" y2="19"></line>
      <line x1="8" y1={bottom} x2="18" y2={bottom}></line>
      <line x1="13" y1={bottom - 5} x2="13" y2={bottom + 5}></line>
      <line x1="302" y1={bottom} x2="312" y2={bottom}></line>
      <line x1="307" y1={bottom - 5} x2="307" y2={bottom + 5}></line>
    </g>
    <slot />
  </svg>
  <figcaption
    class="border-border text-muted-foreground border-t px-4 py-3 text-sm opacity-100"
  >
    <slot name="caption" />
  </figcaption>
</figure>

<style is:global>
  /* Figure colours come only from the blog's theme tokens, so light/dark just
     work. Shapes are told apart by dash, fill and label as well as hue. */
  .swiss-fig {
    --panel: color-mix(in srgb, var(--muted) 50%, var(--background));
    --grid: color-mix(in srgb, var(--foreground) 6%, transparent);
  }
  .swiss-fig svg text {
    fill: var(--foreground);
    font-family:
      "Space Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }
  .swiss-fig svg {
    font-size: 10px;
  }
  .swiss-fig .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .swiss-fig .reg {
    stroke: var(--accent);
    stroke-width: 1.4;
    opacity: 0.7;
  }
  .swiss-fig .bar {
    fill: var(--accent);
  }
  .swiss-fig .box {
    fill: var(--panel);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .swiss-fig .boxa {
    fill: var(--panel);
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .swiss-fig .ghost {
    stroke: var(--muted-foreground);
    stroke-dasharray: 3 2;
  }
  .swiss-fig .wire {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
  }
  .swiss-fig .rule {
    stroke: var(--border);
    stroke-width: 1;
  }
  .swiss-fig svg text.mut {
    fill: var(--muted-foreground);
  }
  .swiss-fig svg text.acc {
    fill: var(--accent);
  }
  .swiss-fig svg text.on-acc {
    fill: var(--accent-foreground);
    font-weight: 700;
  }
  .swiss-fig svg text.k {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .swiss-fig .tick {
    fill: none;
    stroke: var(--accent-foreground);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
