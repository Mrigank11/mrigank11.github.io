---
import SwissFigure from "../development-at-the-speed-of-thought/SwissFigure.astro";

// The rails as stated add up to 0.42 W for Handy and 1.95 W for FluidVoice
// (1.27 + 0.03 + 0.65), a cent of a watt over the recorded "combined" 1.94 W,
// which is rounding from the individually-rounded rails. The total label uses
// the recorded 1.94 W; the bar heights use the rails. See the post's
// methodology note for the larger Handy energy mismatch.

// Watts to px: 1.95 W = 132px, so 0.5 W = ~33.8px. Baseline at y = 180.
const base = 180;
const px = 67.7;
const gap = 2;
const ticks = [0.5, 1.0, 1.5];

// Segments stack from the baseline up: CPU, then GPU, then ANE.
const stack = (rails: number[]) => {
  let top = base;
  return rails.map(w => {
    const h = Math.max(w * px, 2);
    top -= h;
    return { y: top, h };
  });
};
const handy = stack([0.29, 0.13]);
const fluid = stack([1.27, 0.03, 0.65]);
---

<SwissFigure
  height={214}
  label="Stacked bar chart of average power in watts. Handy, 0.42 watts in total: CPU 0.29, GPU 0.13, Neural Engine 0. FluidVoice, 1.94 watts in total: CPU 1.27, GPU 0.03, Neural Engine 0.65. The Neural Engine alone draws more than Handy's whole total."
>
  <defs>
    <pattern
      id="pb-hatch"
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line
        x1="0"
        y1="0"
        x2="0"
        y2="4"
        style="stroke: var(--accent)"
        stroke-width="1.6"></line>
    </pattern>
    <pattern id="pb-dots" width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="0.9" style="fill: var(--accent)"></circle>
    </pattern>
  </defs>

  <text class="k mut" x="24" y="30">avg power drawn · watts</text>

  {
    ticks.map(t => (
      <>
        <line
          class="rule"
          x1="60"
          y1={base - t * px}
          x2="300"
          y2={base - t * px}
        />
        <text class="mut" x="30" y={base - t * px + 3} font-size="9">
          {t.toFixed(1)}
        </text>
      </>
    ))
  }
  <line class="rule" x1="60" y1="40" x2="60" y2={base}></line>
  <line class="rule" x1="60" y1={base} x2="300" y2={base}></line>
  <text class="mut" x="44" y={base + 3} font-size="9">0</text>

  <!-- Handy -->
  <rect
    class="bar"
    x="76"
    y={handy[0].y + gap / 2}
    width="52"
    height={handy[0].h - gap}
    rx="1"></rect>
  <rect
    x="76"
    y={handy[1].y + gap / 2}
    width="52"
    height={handy[1].h - gap}
    rx="1"
    fill="url(#pb-hatch)"
    style="stroke: var(--accent)"
    stroke-width="1"></rect>
  <text x="76" y={handy[1].y - 6} font-size="11" font-weight="700">0.42 W</text>
  <text class="mut" x="76" y="198" font-size="9">Handy</text>
  <text class="mut" x="134" y={handy[1].y + 3} font-size="9">GPU 0.13</text>
  <text class="mut" x="134" y={handy[0].y + handy[0].h / 2 + 3} font-size="9"
    >CPU 0.29</text
  >
  <text class="mut" x="134" y={handy[1].y - 12} font-size="9">ANE 0</text>

  <!-- FluidVoice -->
  <rect
    class="bar"
    x="200"
    y={fluid[0].y + gap / 2}
    width="52"
    height={fluid[0].h - gap}
    rx="1"></rect>
  <rect
    x="200"
    y={fluid[1].y}
    width="52"
    height={fluid[1].h - gap}
    fill="url(#pb-hatch)"
    style="stroke: var(--accent)"
    stroke-width="1"></rect>
  <rect
    x="200"
    y={fluid[2].y + gap / 2}
    width="52"
    height={fluid[2].h - gap}
    rx="1"
    fill="url(#pb-dots)"
    style="stroke: var(--accent)"
    stroke-width="1.2"></rect>
  <text x="200" y={fluid[2].y - 6} font-size="11" font-weight="700">1.94 W</text
  >
  <text class="mut" x="200" y="198" font-size="9">FluidVoice</text>
  <text class="mut" x="258" y={fluid[0].y + fluid[0].h / 2 + 3} font-size="9"
    >CPU 1.27</text
  >
  <text class="mut" x="258" y={fluid[1].y + 3} font-size="9">GPU 0.03</text>
  <text
    class="acc"
    x="258"
    y={fluid[2].y + fluid[2].h / 2 + 3}
    font-size="9"
    font-weight="700">ANE 0.65</text
  >

  <Fragment slot="caption">
    Where the watts go. FluidVoice's CPU did not go quiet, and its Neural Engine
    alone (0.65 W) drew more than everything Handy used (0.42 W).
  </Fragment>
</SwissFigure>
