---
import SwissFigure from "../development-at-the-speed-of-thought/SwissFigure.astro";

// REVIEW: Handy's 0.0096 Wh/min follows from its stated 0.0127 Wh over 79.1 s,
// but its stated 0.42 W over 79.1 s is only about 0.0092 Wh (about 0.0070
// Wh/min). The two Handy numbers do not reconcile; FluidVoice's do.
// Confirm which is right before publishing.

// 0.01 Wh/min = 39.63px; baseline at y = 180.
const base = 180;
const px = 3963;
const handy = 0.0096 * px;
const fluid = 0.0328 * px;
const ticks = [0.01, 0.02, 0.03];
---

<SwissFigure
  height={214}
  label="Bar chart of energy per minute of speech, in watt-hours per minute. Handy: 0.0096. FluidVoice: 0.0328, about 3.4 times as much."
>
  <text class="k mut" x="24" y="30">energy per minute spoken · wh/min</text>

  {
    ticks.map(t => (
      <>
        <line
          class="rule"
          x1="60"
          y1={base - t * px}
          x2="300"
          y2={base - t * px}
        />
        <text class="mut" x="24" y={base - t * px + 3} font-size="9">
          {t.toFixed(2)}
        </text>
      </>
    ))
  }
  <line class="rule" x1="60" y1="40" x2="60" y2={base}></line>
  <line class="rule" x1="60" y1={base} x2="300" y2={base}></line>
  <text class="mut" x="24" y={base + 3} font-size="9">0</text>

  <rect class="bar" x="92" y={base - handy} width="56" height={handy} rx="1"
  ></rect>
  <text x="92" y={base - handy - 8} font-size="11" font-weight="700"
    >0.0096</text
  >
  <text class="k mut" x="92" y="198">Handy</text>

  <rect class="bar" x="212" y={base - fluid} width="56" height={fluid} rx="1"
  ></rect>
  <text x="212" y={base - fluid - 8} font-size="11" font-weight="700"
    >0.0328</text
  >
  <text class="k mut" x="204" y="198">FluidVoice</text>

  <!-- the gap: FluidVoice's bar above Handy's level -->
  <path class="ghost" d="M148,142 H212" fill="none"></path>
  <path
    class="wire"
    d={`M200,${base - fluid} h6 M203,${base - fluid} V${base - handy} M200,${base - handy} h6`}
  ></path>
  <text
    class="acc"
    x="158"
    y="106"
    font-size="15"
    font-weight="700"
    style="font-family: 'Archivo Black', sans-serif">3.4x</text
  >

  <Fragment slot="caption">
    FluidVoice used about 3.4 times the energy per minute of speech. Per minute,
    because the two runs were different lengths.
  </Fragment>
</SwissFigure>
